{
  "name": "akira/filament-tool-kit",
  "description": "This is my package filament-tool-kit",
  "keywords": [
    "akira",
    "laravel",
    "filament-tool-kit"
  ],
  "homepage": "https://github.com/akira/filament-tool-kit",
  "support": {
    "issues": "https://github.com/akira/filament-tool-kit/issues",
    "source": "https://github.com/akira/filament-tool-kit"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "kid",
      "email": "kidiatoliny@akira-io.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "filament/filament": "^3.2.134",
    "laravel/prompts": "^0.1.25",
    "spatie/laravel-package-tools": "^1.18.3"
  },
  "require-dev": {
    "larastan/larastan": "^2.9.12",
    "laravel/pint": "^1.20.0",
    "nunomaduro/collision": "^7.11",
    "orchestra/testbench": "^8.31",
    "pestphp/pest": "^2.36.0",
    "pestphp/pest-plugin-arch": "^2.7",
    "pestphp/pest-plugin-laravel": "^2.4",
    "pestphp/pest-plugin-type-coverage": "^2.8",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan-deprecation-rules": "^1.2.1",
    "phpstan/phpstan-phpunit": "^1.4.2",
    "rector/rector": "^1.2",
    "spatie/laravel-ray": "^1.39.0"
  },
  "autoload": {
    "psr-4": {
      "Akira\\FilamentToolKit\\": "src/",
      "Akira\\FilamentToolKit\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Akira\\FilamentToolKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
    "lint": "pint",
    "refactor": "rector",
    "test:type-coverage": "pest --type-coverage --min=100",
    "test:lint": "pint --test",
    "test:unit": "pest --parallel",
    "test:types": "phpstan",
    "test:refactor": "rector --dry-run",
    "test": [
      "@test:type-coverage",
      "@test:unit",
      "@test:lint",
      "@test:types",
      "@test:refactor"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Akira\\FilamentToolKit\\FilamentToolKitServiceProvider"
      ],
      "aliases": {
        "FilamentToolKit": "Akira\\FilamentToolKit\\Facades\\FilamentToolKit"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
