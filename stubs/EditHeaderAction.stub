<?php

declare(strict_types=1);

namespace {{ namespace }}\Actions\Pages;

use {{ namespace }}\Forms\{{ modelClass }}Form;
use Filament\Actions\EditAction;
use Filament\Schemas\Schema;

final class {{ modelClass }}EditHeaderAction
{
    /**
     * Edit action for the {{ modelClass }} model.
     */
    public static function make(): EditAction
    {
        return EditAction::make()
            ->form(fn (Schema $schema) => {{ modelClass }}Form::make($schema)
            ->columns());
    }
}
