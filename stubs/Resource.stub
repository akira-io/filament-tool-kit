<?php

declare(strict_types=1);

namespace {{ namespace }}\{{ resourceClass }};

use {{ model }};

use {{ namespace }}\{{ resourceClass }}\Forms\{{ modelClass }}Form;
use {{ namespace }}\{{ resourceClass }}\InfoLists\{{ modelClass }}InfoList;
use {{ namespace }}\{{ resourceClass }}\Pages\{{ modelClass }}Pages;
use {{ namespace }}\{{ resourceClass }}\RelationManagers\{{ modelClass }}Relations;
use {{ namespace }}\{{ resourceClass }}\Tables\{{ modelClass }}Table;

use Filament\Resources\Resource;
use Filament\Tables\Table;
use BackedEnum;
use Filament\Schemas\Schema;

final class {{ resourceClassName }} extends Resource
{
    protected static ?string $model = {{ modelClass }}::class;

    protected static string|BackedEnum|null $navigationIcon = 'heroicon-o-rectangle-stack';

    protected static string|BackedEnum|null $activeNavigationIcon = 'heroicon-s-rectangle-stack';

     /**
      * Get the singular navigation label for the resource.
      *
      */
     public static function getLabel(): string
     {
        return __('{{ resourceLabel }}');
     }

    /**
     * Get the plural navigation label for the resource.
     *
     */
    public static function getPluralLabel(): string
    {
        return __('{{ resourcePluralLabel }}');
    }

    /**
     * Get the form for the resource.
     *
     */
    public static function form(Schema $schema): Schema
    {
        return {{ modelClass }}Form::make($schema);
    }

    /**
     * Get the table for the resource.
     *
     */
    public static function table(Table $table): Table
    {
        return {{ modelClass }}Table::make($table);
    }

    /**
     * Get the infolist for the resource.
     *
     */
     public static function infolist(Schema $schema): Schema
     {
        return {{ modelClass }}Infolist::make($schema);
     }


    /**
     * Get the pages for the resource.
     *
     */
    public static function getPages(): array
    {
       return {{ modelClass }}Pages::make();
    }

    /**
     * Get the relations for the resource.
     *
     */
    public static function getRelations(): array
    {
       return {{ modelClass }}Relations::make();
     }
}
